modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "React Native Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Preview"

[[workflows.workflow]]
name = "React Native Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npx react-native start --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Web Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web-preview && npm start"
waitForPort = 5001

[deployment]
run = ["sh", "-c", "npm install && npx react-native start --port 5000"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000
